@Learnaptic.Api_HostAddress = http://localhost:5075
@studyGuideId = 2
@conceptId = 1

### Get all study guides
GET {{Learnaptic.Api_HostAddress}}/api/study-guides
Accept: application/json

### Get a specific study guide by ID
GET {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}
Accept: application/json

### Create a new study guide
POST {{Learnaptic.Api_HostAddress}}/api/study-guides
Content-Type: application/json

{
  "title": "Biology Exam Review",
  "description": "Chapters 1-3",
  "subject": "Biology"
}

### Update an existing study guide
PUT {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}
Content-Type: application/json

{
  "title": "Updated Biology Exam Review",
  "description": "Chapters 1-4",
  "subject": "Biology"
}

### Delete a study guide
DELETE {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}

### Get all concepts for a specific study guide
GET {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}/concepts

### Get a specific concept by ID for a specific study guide
GET {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}/concepts/{{conceptId}}

### Create a new concept for a specific study guide
POST {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}/concepts
Content-Type: application/json
{
  "title": "Cell Structure",
  "content": "Cells are the basic building blocks of all living organisms..."
}

### Update an existing concept for a specific study guide
PUT {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}/concepts/{{conceptId}}
{
  "title": "Updated Cell Structure",
  "content": "Cells are the fundamental units of life, and they come in various types..."
}

### Delete a concept for a specific study guide
DELETE {{Learnaptic.Api_HostAddress}}/api/study-guides/{{studyGuideId}}/concepts/{{conceptId}}

